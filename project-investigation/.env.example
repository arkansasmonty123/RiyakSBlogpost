# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# PROD-010 verdict integrity (all optional; defaults shown).
# Apply migrations/003_prod010_verdict_integrity.sql before using these.
# Minimum plausible deduction checkpoints required before a final accusation.
ACCUSATION_REQUIRED_CHECKPOINTS=1
# Keyword coverage (0-1) and absolute overlap required for motive/method text.
ACCUSATION_MOTIVE_THRESHOLD=0.18
ACCUSATION_METHOD_THRESHOLD=0.18
ACCUSATION_MIN_KEYWORD_OVERLAP=4
# Minimum count of player-known supporting evidence ids required.
ACCUSATION_MIN_SUPPORTING_EVIDENCE=1
# Escalating cooldown: BASE * 2^(attempts-1), capped at MAX (milliseconds).
ACCUSATION_BASE_COOLDOWN_MS=2000
ACCUSATION_MAX_COOLDOWN_MS=60000

# P2-RATE-LIMITS (all optional; dev defaults shown). Counters are DB-backed in
# the `rate_limits` table; apply migrations/005_p2_db_rate_limits.sql first.
# Set RATE_LIMIT_ENABLED=false to disable all limits (e.g. load tests).
RATE_LIMIT_ENABLED=true
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=500
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=120
WRITE_RATE_WINDOW_MS=60000
WRITE_RATE_MAX=600

# AI provider (pluggable). Defaults to local OpenAI-compatible endpoint with deterministic fallback.
# USE_LLM=false disables external LLM calls and uses deterministic responder only.
# LLM_PROVIDER=auto|local|openai|gemini (auto: gemini if API key set without LLM_URL, else local)
# For Google AI Studio/Gemini, set GEMINI_API_KEY (or GOOGLE_API_KEY/LLM_API_KEY) and optionally LLM_PROVIDER=gemini.
# GEMINI_API_KEY=""
# LLM_PROVIDER=auto
# LLM_URL=http://127.0.0.1:8080/v1/chat/completions
# LLM_MODEL=qwen2.5-1.5b-instruct
# LLM_API_KEY=""

# M8-5 AI quality/cost controls (all optional; safe defaults preserved).
# Setting these caps overrides the per-call defaults used by chat and discovery:
# chat defaults to 15000ms / 220 tokens / 0.7, discovery uses its own bounded
# values. Values below are examples, not required settings.
# LLM_TIMEOUT_MS=12000
# LLM_MAX_TOKENS=300
# LLM_TEMPERATURE=0.2
# Optional one-shot failover. Activated only when LLM_FAILOVER_URL or
# LLM_FAILOVER_PROVIDER is set; a single retry is attempted when the primary
# endpoint fails or times out. Otherwise the deterministic fallback is used.
# LLM_FAILOVER_PROVIDER=openai
# LLM_FAILOVER_URL=http://127.0.0.1:8081/v1/chat/completions
# LLM_FAILOVER_MODEL=gpt-4o-mini
# LLM_FAILOVER_API_KEY=""
# Every attempted call emits a secret-free `[LLM-METRICS]` JSON log line with
# provider/model/latency/prompt size/max tokens/outcome/fallback/failover fields.
# For separate-provider failover set LLM_FAILOVER_API_KEY explicitly; otherwise
# the primary provider key is reused (the server warns about this in production).

# ---------------------------------------------------------------------------
# M8-W6 production hardening (all optional; safe dev defaults preserved).
# ---------------------------------------------------------------------------
# NODE_ENV=production turns on Secure session cookies and enables startup
# warnings for the risky settings below. Set it in any public deployment.
# NODE_ENV=production

# Allowed browser origin for CORS (single value) and as the primary CSRF
# Origin/Referer allowlist entry. Must match the deployed frontend exactly.
FRONTEND_URL="http://localhost:5173"
# Optional extra trusted origins for the CSRF check (comma-separated).
# ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# Max size of a JSON/urlencoded request body. 1mb is ample for this API.
JSON_BODY_LIMIT="1mb"

# Lightweight CSRF mitigation: mutating requests (POST/PATCH/PUT/DELETE) with
# an Origin or Referer header must match FRONTEND_URL, ALLOWED_ORIGINS, or the
# request's own Host. Requests with NO Origin/Referer (CLI/curl/services) are
# allowed. Keep enabled in production; only disable for isolated test harnesses.
CSRF_ORIGIN_CHECK=true

# TIGHTEN rate limits for public traffic (dev defaults below are deliberately
# generous so local smoke tests from one IP are not throttled):
# AUTH_RATE_MAX=20
# CHAT_RATE_MAX=30
# WRITE_RATE_MAX=60
# Keep RATE_LIMIT_ENABLED=true in production (the server warns if disabled).
# F7: if you enable LLM failover, set a dedicated key so the primary provider's
# credentials are not reused for the failover provider.
# LLM_FAILOVER_API_KEY=""

# ---------------------------------------------------------------------------
# M8-W7 beta readiness (all optional; safe dev defaults preserved).
# ---------------------------------------------------------------------------
# Version string reported by GET /api/health and GET /api/config. Never contains
# secrets. Set to your release tag in deployment for traceability.
# APP_VERSION="beta-1"
# Public feedback destination used by the footer/legal pages. Any http(s) URL
# or mailto: address works; no third-party integration is required. Operators
# MUST set this to a real address before inviting beta users.
# FEEDBACK_URL="mailto:beta@example.com"
# Closed beta: when set, POST /api/register requires this shared code in the
# `betaAccessCode` field. Leave UNSET for development, CI and the smoke suite.
# Treat it as a secret; it is never returned by any endpoint.
# BETA_ACCESS_CODE=""
# Readiness probe: set true to make GET /api/health run a lightweight DB check
# (adds `db: ok|unavailable`; returns 503 when unavailable). Off by default so
# liveness checks stay cheap and independent of DB availability.
# HEALTH_DB_CHECK=false
