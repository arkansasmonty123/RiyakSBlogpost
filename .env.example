# THE BAR - environment variables (P0 prototype)
# All variables are optional; src/config/env.ts supplies validated defaults and
# no secrets are required for the localStorage-only prototype.
# Runtime AI is disabled in P0: provider/endpoint/key values below are ignored
# (with a warning) and never enable a model or network call.

# Display name shown in the app header (trimmed, capped; default: THE BAR)
# VITE_APP_NAME=THE BAR

# Only "disabled" is supported in P0; unknown values fall back to disabled
# VITE_RUNTIME_AI_PROVIDER=disabled

# Reserved for a future Phase 6 adapter; ignored while AI is disabled
# VITE_RUNTIME_AI_ENDPOINT=
# VITE_RUNTIME_AI_API_KEY=
