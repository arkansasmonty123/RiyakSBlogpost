PORT=3001
NEGOTIATION_DB_PATH=data/negotiation.db

# Deployment
# NODE_ENV=production
# FRONTEND_URL=https://neg.example.com        # canonical client origin
# ALLOWED_ORIGINS=https://a.example.com,https://b.example.com  # exact origins; overrides FRONTEND_URL

# Optional: configure an LLM provider. If no key is set, deterministic fallback is used.
# LLM_PROVIDER=openai|gemini|local|ollama
# LLM_API_KEY=          # also accepts OPENAI_API_KEY / GEMINI_API_KEY / GOOGLE_API_KEY
#                       # not required for local/ollama (any non-empty value works)
# LLM_MODEL=qwen3.5:2b  # or qwen3.5:0.8b for low-resource CPU
# LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# MAX_LLM_CALLS_PER_SESSION=40
# LLM_TIMEOUT_MS=120000 # increase for local CPU inference

# Opt-in real-LLM E2E (see docs/TESTING.md); never set in production.
# LLM_E2E=1
